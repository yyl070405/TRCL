{
  "name": "trcl",
  "version": "0.1.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "TRCL (Tiny Runtime Craft Launcher) — cross-platform Minecraft Java Edition launcher",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node src/server/index.js --open",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "app": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.mclauncher.app",
    "productName": "TRCL",
    "files": [
      "src/**/*",
      "ui/**/*",
      "electron/**/*",
      "LICENSE",
      "NOTICE.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "installer/NOTICE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "ui/icon-512.png",
      "executableName": "TRCL"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "synopsis": "Minecraft Java Edition launcher"
    },
    "asar": false,
    "artifactName": "TRCL-${version}-${os}-${arch}.${ext}",
    "icon": "ui/icon-512.png",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TRCL",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "runAfterFinish": true,
      "license": "installer/NOTICE.rtf"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraFiles": [
      {
        "from": "installer/trcl.cmd",
        "to": "trcl.cmd"
      }
    ]
  },
  "main": "electron/main.cjs",
  "author": "yyl070405 <yyl070405@users.noreply.github.com>",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/yyl070405/TRCL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyl070405/TRCL.git"
  },
  "bugs": {
    "url": "https://github.com/yyl070405/TRCL/issues"
  }
}
